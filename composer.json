{
    "name": "n5s/wpstarter",
    "type": "wpstarter-extension",
    "authors": [
        {
            "name": "Nicolas Lemoine",
            "email": "nico@n5s.dev"
        }
    ],
    "require": {
        "wecodemore/wpstarter": "dev-wpstarter-next",
        "roots/wordpress": "^6.1 || ^7"
    },
    "require-dev": {
        "symplify/easy-coding-standard": "^12"
    },
    "extra": {
        "wpstarter-autoload": {
            "psr-4": {
                "n5s\\WpStarter\\": "src/"
            }
        }
    },
    "config": {
        "allow-plugins": {
            "roots/wordpress-core-installer": true,
            "composer/installers": true,
            "wecodemore/wpstarter": true
        }
    },
    "scripts": {
        "cs": "ecs check",
        "cs:fix": "ecs check --fix"
    }
}
